MODEL_API_KEY=replace-with-your-api-key
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=replace-with-model-name
MODEL_TIMEOUT=60
# Retry count must be an integer from 0 to 5.
MODEL_MAX_RETRIES=2
# Response limit must be an integer from 1024 to 10000000 bytes.
MODEL_MAX_RESPONSE_BYTES=2000000
AGENT_MAX_TURNS=20
MAX_CONTEXT_CHARS=100000
MAX_NO_PROGRESS_TURNS=3
COMMAND_TIMEOUT=60
# MAX_TOOL_OUTPUT must be an integer >= 100.
MAX_TOOL_OUTPUT=20000
